# ===== Credenciales / entorno =====
.env
.env.*

# ===== Python =====
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ===== Caché de la API =====
cache/

# ===== Datos (Data/) =====
# Por defecto se ignora TODO Data...
/Data/*
# ...pero se rastrean SOLO las dos regiones de interés (su estructura + textos).
!/Data/Tamaulipas/
!/Data/Puerto_Rico/

# Dentro de las regiones NO se versionan datos pesados ni reproducibles:
# crudos descargados (miles de parquet, re-descargables vía pipeline)
Data/**/crudos_api/
# datasets consolidados y cualquier binario grande (se comparten aparte / se regeneran)
Data/**/*.parquet
Data/**/*.h5
Data/**/*.log

# Históricos (no interesan en el repo)
Data/Tamaulipas/historico_4501_con_mar/
Data/Puerto_Rico/historico_2480_0.02/

# ===== Resultados de forecast (Results/) =====
# Se versiona el rastro reproducible del experimento (config, métricas, summary,
# feature importance, modelo entrenado) pero NO los binarios que se regeneran.

# Caché de datasets de features: cientos de MB por combinación de bloques,
# se reconstruye con features/builder.py a partir de Data/.
Results/**/experiments/datasets/

# Predicciones sobre test: se regeneran cargando model.json + el dataset.
Results/**/predictions_test.parquet

# ===== Reanálisis Copernicus (copernicus/) =====
# NetCDF crudos y series extraídas: gigabytes, y se rebajan del CDS con
# `python -m copernicus.descarga`. Se versiona el código, no los datos.
Data/**/era5/

# Salidas del notebook de referencia de ERA5 (otro proyecto, Monterrey).
ERA5/ERA5_Data*/
ERA5/*.nc

# ===== macOS =====
.DS_Store

# ===== Análisis urbano (urbano/) =====
# El HTML interactivo pesa 4 MB (lleva los 4384 nodos embebidos) y se regenera
# con `python -m urbano.construir`. Los PNG sí se versionan: son el entregable
# que se cita en el informe.
Results/**/urbano/*.html

# Series climáticas por ciudad: un juego completo de ámbitos son ~395 MB
# (86 MB solo en CSV), todos reproducibles con
# `python -m urbano.clima.construir_clima --todos-los-ambitos`.
# Se ignora la carpeta entera y se rescatan los dos resúmenes de referencia:
# el de las 12 ciudades mayores y el agregado estatal.
Data/**/urbano/clima/*
!Data/**/urbano/clima/diario_ciudades.csv
!Data/**/urbano/clima/diario_global.csv
# Los resúmenes de nodos señalados son 12 y 43 filas: se versionan.
!Data/**/urbano/clima/resumen_nodos_interes.csv
!Data/**/urbano/clima/resumen_nodos_municipios.csv
